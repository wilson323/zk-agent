{
  "name": "zk-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI多智能体宇宙平台 - 集成对话智能体、CAD分析专家、AI海报设计师",
  "author": "ZK-Agent Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:integration:api": "jest --testPathPattern=__tests__/api",
    "test:integration:database": "jest --testPathPattern=__tests__/database",
    "test:smoke": "jest --testPathPattern=__tests__/smoke",
    "test:regression": "jest --testPathPattern=__tests__/regression",
    "test:load": "k6 run tests/performance/load-test.js",
    "test:stress": "k6 run tests/performance/stress-test.js",
    "test:memory": "node tests/performance/memory-test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:integration:api && npm run test:e2e",
    "test:ci": "npm run test:all && npm run test:security && npm run test:performance",
    "validate:config": "node scripts/validate-config.js",
    "check:conflicts": "node scripts/check-config-conflicts.js",
    "coverage:merge": "nyc merge coverage/production coverage/merged.json",
    "coverage:html": "nyc report --reporter=html --temp-dir=coverage/production",
    "coverage:json": "nyc report --reporter=json --temp-dir=coverage/production",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dry-run": "prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-schema-datasource prisma/schema.prisma",
    "db:migrate:test": "DATABASE_URL=$DATABASE_URL_TEST prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:seed:test": "DATABASE_URL=$DATABASE_URL_TEST tsx prisma/seeds/test.ts",
    "db:reset": "prisma migrate reset --force",
    "db:reset:test": "DATABASE_URL=$DATABASE_URL_TEST prisma migrate reset --force",
    "db:init": "node scripts/database-init.js",
    "db:health-check": "node -e \"require('./lib/database/connection-health').testConnection().then(() => console.log('✅ 数据库连接正常')).catch(e => { console.error('❌ 数据库连接失败:', e.message); process.exit(1); })\"",
    "db:performance-report": "node -e \"const monitor = require('./lib/database/performance-monitor'); monitor.generateReport().then(r => console.log(JSON.stringify(r, null, 2)));\"",
    "security:audit": "npm audit --audit-level high",
    "security:scan:all": "node scripts/security/security-scanner.js all",
    "security:scan:basic": "node scripts/security/security-scanner.js basic",
    "security:scan:code": "node scripts/security/security-scanner.js code",
    "security:scan:deps": "node scripts/security/security-scanner.js dependencies",
    "security:scan:config": "node scripts/security/security-scanner.js config",
    "security:scan:files": "node scripts/security/security-scanner.js files",
    "security:zap": "docker run --rm -v $(pwd)/test-reports:/zap/wrk owasp/zap2docker-stable zap-baseline.py -t http://localhost:3000 -J zap-report.json",
    "performance:test": "node scripts/performance/fast-performance-tester.js",
    "performance:test:all": "node scripts/performance/fast-performance-tester.js all",
    "performance:test:basic": "node scripts/performance/fast-performance-tester.js basic",
    "performance:test:bundle": "node scripts/performance/fast-performance-tester.js bundle",
    "performance:test:memory": "node scripts/performance/fast-performance-tester.js memory",
    "performance:test:api": "node scripts/performance/fast-performance-tester.js api",
    "performance:test:full": "node scripts/performance/performance-tester.js",
    "monitor:progress": "node scripts/monitoring/development-progress-lite.js",
    "monitor:risk": "node scripts/monitoring/risk-detection-lite.js",
    "monitor:quality": "node scripts/monitoring/quality-gates.js",
    "monitor:task": "node scripts/monitoring/task-analysis.js",
    "monitor:quality:dev": "node scripts/monitoring/quality-gates.js development",
    "monitor:quality:staging": "node scripts/monitoring/quality-gates.js staging",
    "monitor:quality:prod": "node scripts/monitoring/quality-gates.js production",
    "monitor:all": "npm run monitor:progress && npm run monitor:risk && npm run monitor:quality:dev",
    "monitor:comprehensive": "npm run monitor:progress && npm run monitor:risk && npm run monitor:quality:dev && echo '\n=== 系统监控完成 ===' && echo '📄 报告位置: reports/' && ls -la reports/",
    "analyze:code": "node scripts/comprehensive-code-analysis.js",
    "analyze:dead-code": "node scripts/dead-code-analyzer.js",
    "cleanup:auto": "node scripts/auto-cleanup.js",
    "cleanup:smart": "node scripts/smart-cleanup.js",
    "quality:check": "npm run analyze:code && npm run analyze:dead-code",
    "quality:fix": "npm run cleanup:auto && npm run cleanup:smart",
    "tools:run": "node scripts/tools/tool-manager.js run",
    "tools:install": "node scripts/tools/tool-manager.js install",
    "tools:status": "node scripts/tools/tool-manager.js status",
    "tools:config": "node scripts/tools/tool-manager.js config",
    "tools:uninstall": "node scripts/tools/tool-manager.js uninstall",
    "tools:chunk": "node scripts/tools/intelligent-chunking.js",
    "ci:optimize": "node scripts/ci/optimize-pipeline.js",
    "ci:check-compatibility": "node scripts/tools/environment-compatibility-checker.js",
    "ci:validate": "npm run lint && npm run type-check && npm run test:unit",
    "ci:analyze": "node scripts/ci/comprehensive-cicd-analyzer.js",
    "ci:analyze:optimize": "node scripts/ci/comprehensive-cicd-analyzer.js --optimize",
    "ci:report": "npm run ci:analyze && echo '📊 CI/CD分析报告已生成: reports/cicd-comprehensive-analysis.json'",
    "ci:github:optimize": "node scripts/ci/github-actions-optimizer.js",
    "ci:github:optimize:dry": "node scripts/ci/github-actions-optimizer.js --dry-run",
    "ci:github:analyze": "node scripts/ci/github-actions-optimizer.js --verbose --dry-run",
    "deps:analyze": "node scripts/tools/dependency-analyzer.js",
    "deps:prune": "node scripts/tools/tool-manager.js run ts-prune",
    "deps:check": "node scripts/tools/tool-manager.js run depcheck",
    "deps:circular": "node scripts/tools/tool-manager.js run madge",
    "lint:enhanced": "node scripts/tools/eslint-enhancer.js",
    "lint:unused": "node scripts/tools/tool-manager.js run eslint-unused-imports",
    "quality:check:all": "node scripts/quality/custom-quality-checker.js all",
    "quality:check:basic": "node scripts/quality/custom-quality-checker.js basic",
    "quality:check:security": "node scripts/quality/custom-quality-checker.js security",
    "quality:check:performance": "node scripts/quality/custom-quality-checker.js performance",
    "quality:check:monitoring": "node scripts/quality/custom-quality-checker.js monitoring",
    "start:test": "NODE_ENV=test npm start",
    "start:production": "NODE_ENV=production npm start",
    "build:production": "NODE_ENV=production npm run build",
    "validate:project": "node scripts/validate-project.js",
    "ci:check": "npm run type-check && npm run lint && npm run test && npm run security:audit",
    "consistency:check": "node scripts/check-consistency.js",
    "consistency:check:verbose": "node scripts/check-consistency.js --verbose",
    "consistency:check:report": "node scripts/check-consistency.js --report",
    "consistency:fix": "node scripts/check-consistency.js --fix",
    "consistency:fix:report": "node scripts/check-consistency.js --fix --report",
    "techstack:unify": "node scripts/unify-tech-stack.js",
    "techstack:unify:dry-run": "node scripts/unify-tech-stack.js --dry-run",
    "techstack:unify:verbose": "node scripts/unify-tech-stack.js --verbose",
    "architecture:validate": "npm run consistency:check && npm run techstack:unify:dry-run",
    "architecture:fix": "npm run techstack:unify && npm run consistency:fix",
    "architecture:report": "npm run consistency:check:report && npm run techstack:unify:dry-run",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer"
  },
