{
    "compilerOptions":  {
                            "types":  [
                                          "jest",
                                          "node",
                                          "@testing-library/jest-dom"
                                      ],
                            "allowSyntheticDefaultImports":  true,
                            "esModuleInterop":  true
                        },
    "include":  [
                    "**/*.test.ts",
                    "**/*.test.tsx",
                    "**/*.spec.ts",
                    "**/*.spec.tsx",
                    "tests/**/*",
                    "__tests__/**/*"
                ],
    "extends":  "./tsconfig.json"
}
