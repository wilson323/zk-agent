{
    "compilerOptions":  {
                            "noUnusedLocals":  true,
                            "sourceMap":  false,
                            "noUnusedParameters":  true
                        },
    "exclude":  [
                    "node_modules",
                    "**/*.test.ts",
                    "**/*.test.tsx",
                    "**/*.spec.ts",
                    "**/*.spec.tsx",
                    "tests",
