{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔧 运行所有代码质量工具",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tools:run"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "运行所有配置的代码质量和依赖分析工具",
      "icon": {
        "id": "tools",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "📊 查看工具状态",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tools:status"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "显示所有工具的安装和启用状态",
      "icon": {
        "id": "info",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "🌲 检查未使用的导出 (ts-prune)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deps:prune"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "ts-prune",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+) - (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      "detail": "使用 ts-prune 检测未使用的 TypeScript 导出",
      "icon": {
        "id": "symbol-method",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "📦 检查未使用的依赖 (depcheck)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deps:check"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "使用 depcheck 检测未使用的 npm 依赖包",
      "icon": {
        "id": "package",
        "color": "terminal.ansiMagenta"
      }
    },
    {
      "label": "🔄 检查循环依赖 (madge)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deps:circular"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "madge",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1,
          "message": "Circular dependency detected"
        }
      },
      "detail": "使用 madge 检测模块间的循环依赖",
      "icon": {
        "id": "symbol-event",
        "color": "terminal.ansiRed"
      }
    },
    {
      "label": "🧹 检查未使用的导入 (ESLint)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:unused"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$eslint-stylish",
      "detail": "使用 ESLint 检测并修复未使用的导入",
      "icon": {
        "id": "symbol-class",
        "color": "terminal.ansiCyan"
      }
    },
    {
      "label": "📁 检查未引用的文件 (unimported)",
      "type": "shell",
      "command": "npx",
      "args": ["unimported"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "使用 unimported 检测项目中未被引用的文件",
      "icon": {
        "id": "file",
        "color": "terminal.ansiWhite"
      }
    },
    {
      "label": "🕸️ 高级依赖分析 (dependency-cruiser)",
      "type": "shell",
      "command": "npx",
      "args": ["depcruise", "--validate", ".dependency-cruiser.js", "src"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "dependency-cruiser",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s*(.*):(\\d+):(\\d+)\\s+(error|warn|info)\\s+(.*)\\s+\\((.*)\\)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      },
      "detail": "使用 dependency-cruiser 进行高级依赖关系分析",
      "icon": {
        "id": "graph",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "📊 依赖分析报告",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deps:analyze"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "生成综合的依赖分析报告",
      "icon": {
        "id": "graph-line",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "🔧 安装代码质量工具",
      "type": "shell",
      "command": "npm",
      "args": ["install", "-g", "depcheck", "madge", "unimported", "npm-check"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "全局安装所有需要的代码质量工具",
      "icon": {
        "id": "cloud-download",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "🚀 快速质量检查",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:enhanced"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$eslint-stylish",
      "detail": "运行增强的 ESLint 检查，包括未使用导入检测",
      "icon": {
        "id": "rocket",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "📋 生成工具配置",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tools:config"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "显示当前工具管理器的配置",
      "icon": {
        "id": "settings-gear",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "🔍 npm 安全审计",
      "type": "shell",
      "command": "npm",
      "args": ["audit"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "运行 npm 安全审计检查依赖漏洞",
      "icon": {
        "id": "shield",
        "color": "terminal.ansiRed"
      }
    },
    {
      "label": "📈 依赖健康检查",
      "type": "shell",
      "command": "npx",
      "args": ["npm-check"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "检查依赖的健康状况和更新情况",
      "icon": {
        "id": "pulse",
        "color": "terminal.ansiGreen"
      }
    }
  ],
  "inputs": [
    {
      "id": "toolName",
      "description": "选择要运行的工具",
      "type": "pickString",
      "options": [
        "all",
        "ts-prune",
        "depcheck",
        "madge",
        "unimported",
        "dependency-cruiser",
        "eslint-unused-imports",
        "ts-unused-exports",
        "npm-check"
      ],
      "default": "all"
    }
  ]
}