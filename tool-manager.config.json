{
  "tools": {
    "ts-prune": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "daily",
      "options": {
        "exclude": [
          "**/*.test.*",
          "**/*.spec.*",
          "**/*.stories.*",
          "**/node_modules/**",
          "**/.next/**",
          "**/dist/**",
          "**/build/**"
        ]
      }
    },
    "depcheck": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "weekly",
      "options": {
        "ignoreMatches": [
          "@types/*",
          "eslint-*",
          "@typescript-eslint/*",
          "@testing-library/*",
          "@playwright/*",
          "vitest",
          "jest",
          "prettier",
          "typescript"
        ],
        "ignoreDirs": [
          "node_modules",
          ".next",
          "dist",
          "build",
          "coverage"
        ]
      }
    },
    "madge": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "daily",
      "options": {
        "circular": true,
        "extensions": ["js", "ts", "tsx", "jsx"],
        "exclude": [
          "node_modules",
          ".next",
          "dist",
          "build"
        ],
        "detectiveOptions": {
          "ts": {
            "skipTypeImports": true
          }
        }
      }
    },
    "unimported": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "weekly",
      "options": {
        "ignore": [
          "**/*.test.*",
          "**/*.spec.*",
          "**/*.stories.*",
          "**/node_modules/**",
          "**/.next/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "next.config.js",
          "tailwind.config.js",
          "postcss.config.js",
          "jest.config.js",
          "vitest.config.ts",
          "playwright.config.ts"
        ]
      }
    },
    "dependency-cruiser": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "weekly",
      "options": {
        "outputType": "json",
        "exclude": {
          "path": [
            "node_modules",
            ".next",
            "dist",
            "build",
            "coverage"
          ]
        },
        "forbidden": [
          {
            "name": "no-circular",
            "severity": "error",
            "comment": "不允许循环依赖",
            "from": {},
            "to": {
              "circular": true
            }
          },
          {
            "name": "no-orphans",
            "severity": "warn",
            "comment": "检测孤立文件",
            "from": {
              "orphan": true,
              "pathNot": [
                "(^|/)\\.[^/]+\\.(js|cjs|mjs|ts|json)$",
                "\\.d\\.ts$",
                "(^|/)tsconfig\\.json$",
                "(^|/)package\\.json$",
                "(^|/)next\\.config\\.(js|ts)$",
                "(^|/)tailwind\\.config\\.(js|ts)$"
              ]
            },
            "to": {}
          }
        ]
      }
    },
    "eslint-unused-imports": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "daily",
      "options": {
        "autoFix": true,
        "extensions": [".js", ".jsx", ".ts", ".tsx"],
        "ignore": [
          "node_modules/**",
          ".next/**",
          "dist/**",
          "build/**",
          "coverage/**"
        ]
      }
    },
    "ts-unused-exports": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "weekly",
      "options": {
        "excludePathsFromReport": [
          "**/*.test.*",
          "**/*.spec.*",
          "**/*.stories.*",
          "**/node_modules/**",
          "**/.next/**",
          "**/dist/**",
          "**/build/**",
          "app/layout.tsx",
          "app/page.tsx",
          "app/not-found.tsx",
          "app/error.tsx",
          "app/loading.tsx",
          "app/global-error.tsx",
          "middleware.ts",
          "next.config.js",
          "tailwind.config.js"
        ]
      }
    },
    "npm-check": {
      "enabled": true,
      "autoInstall": true,
      "schedule": "monthly",
      "options": {
        "update": false,
        "skipUnused": false,
        "ignoreDev": false,
        "ignorePackages": [
          "@types/node",
          "typescript"
        ]
      }
    }
  },
  "reporting": {
    "format": ["json", "html"],
    "includeTimestamp": true,
    "archiveOldReports": true,
    "maxArchiveAge": 30,
    "outputDir": "reports/tool-manager",
    "detailedReports": true,
    "includeMetrics": true
  },
  "automation": {
    "runOnCommit": true,
    "runOnPush": true,
    "failOnErrors": false,
    "failOnWarnings": false,
    "notifications": {
      "enabled": true,
      "channels": ["console", "file"],
      "webhooks": []
    },
    "scheduling": {
      "enabled": true,
      "cron": {
        "daily": "0 9 * * *",
        "weekly": "0 9 * * 1",
        "monthly": "0 9 1 * *"
      }
    }
  },
  "performance": {
    "parallel": true,
    "maxConcurrency": 3,
    "timeout": 300000,
    "retryOnFailure": true,
    "maxRetries": 2
  },
  "integration": {
    "ci": {
      "enabled": true,
      "failBuild": false,
      "generateArtifacts": true
    },
    "preCommitHooks": {
      "enabled": true,
      "tools": ["eslint-unused-imports", "ts-prune"]
    },
    "ide": {
      "vscode": {
        "enabled": true,
        "tasks": true,
        "problemMatchers": true
      }
    }
  },
  "thresholds": {
    "unusedImports": {
      "error": 50,
      "warning": 20
    },
    "unusedExports": {
      "error": 100,
      "warning": 50
    },
    "circularDependencies": {
      "error": 5,
      "warning": 2
    },
    "unusedDependencies": {
      "error": 10,
      "warning": 5
    }
  }
}