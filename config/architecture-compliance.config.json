{
  "architecturePatterns": {
    "cleanArchitecture": {
      "name": "Clean Architecture",
      "description": "清洁架构模式符合度检测",
      "enabled": true,
      "thresholds": {
        "entityIndependence": 90,
        "useCasePurity": 85,
        "frameworkIsolation": 80
      },
      "rules": [
        {
          "id": "no-framework-in-entities",
          "description": "实体层不应依赖框架",
          "severity": "error",
          "pattern": "entities/**/*.ts",
          "forbiddenImports": ["react", "next", "express", "fastapi"]
        },
        {
          "id": "dependency-inversion",
          "description": "依赖倒置原则检查",
          "severity": "warning",
          "pattern": "lib/services/**/*.ts",
          "requiredPattern": "interface.*Repository"
        }
      ]
    },
    "ddd": {
      "name": "Domain Driven Design",
      "description": "领域驱动设计模式符合度检测",
      "enabled": true,
      "thresholds": {
        "aggregateRootIntegrity": 90,
        "valueObjectPurity": 85,
        "repositoryCompliance": 80
      },
      "rules": [
        {
          "id": "aggregate-root-consistency",
          "description": "聚合根一致性检查",
          "severity": "error",
          "pattern": "lib/domain/**/*.ts",
          "requiredMethods": ["getId", "getVersion"]
        },
        {
          "id": "value-object-immutability",
          "description": "值对象不可变性检查",
          "severity": "warning",
          "pattern": "lib/domain/value-objects/**/*.ts",
          "forbiddenKeywords": ["set", "update", "modify"]
        }
      ]
    },
    "microservices": {
      "name": "Microservices Architecture",
      "description": "微服务架构模式符合度检测",
      "enabled": true,
      "thresholds": {
        "serviceAutonomy": 85,
        "communicationLightweight": 80,
        "dataIsolation": 90
      },
      "rules": [
        {
          "id": "service-boundary-isolation",
          "description": "服务边界隔离检查",
          "severity": "error",
          "pattern": "app/api/**/*.ts",
          "forbiddenCrossServiceCalls": true
        },
        {
          "id": "database-per-service",
          "description": "每服务独立数据库检查",
          "severity": "warning",
          "pattern": "lib/database/**/*.ts",
          "maxSharedTables": 2
        }
      ]
    },
    "cqrs": {
      "name": "Command Query Responsibility Segregation",
      "description": "命令查询职责分离模式符合度检测",
      "enabled": true,
      "thresholds": {
        "commandQuerySeparation": 90,
        "readWriteModelConsistency": 85
      },
      "rules": [
        {
          "id": "command-query-separation",
          "description": "命令查询分离检查",
          "severity": "error",
          "pattern": "lib/cqrs/**/*.ts",
          "commandPattern": "*Command.ts",
          "queryPattern": "*Query.ts"
        }
      ]
    }
  },
  "qualityMetrics": {
    "codeQuality": {
      "minScore": 95,
      "metrics": [
        "complexity",
        "maintainability",
        "testability",
        "reusability"
      ]
    },
    "testCoverage": {
      "minCoverage": 90,
      "types": [
        "unit",
        "integration",
        "e2e"
      ]
    },
    "performance": {
      "maxRegressionPercent": 5,
      "benchmarks": [
        "responseTime",
        "throughput",
        "memoryUsage"
      ]
    },
    "security": {
      "maxHighVulnerabilities": 0,
      "scanTypes": [
        "dependencies",
        "codeAnalysis",
        "secretsDetection"
      ]
    }
  },
  "monitoring": {
    "realTimeChecks": {
      "enabled": true,
      "triggers": [
        "onSave",
        "onCommit",
        "onPush"
      ],
      "maxExecutionTime": 30
    },
    "reporting": {
      "format": "dashboard",
      "frequency": "realtime",
      "outputs": [
        "console",
        "file",
        "webhook"
      ]
    }
  },
  "adaptiveThresholds": {
    "projectStage": {
      "mvp": {
        "toleranceMultiplier": 1.2,
        "description": "MVP阶段适当放宽标准"
      },
      "production": {
        "toleranceMultiplier": 0.9,
        "description": "生产环境严格要求"
      }
    },
    "teamSize": {
      "small": {
        "maxComplexity": 15,
        "description": "小团队适当放宽复杂度要求"
      },
      "large": {
        "maxComplexity": 10,
        "description": "大团队严格控制复杂度"
      }
    }
  }
}