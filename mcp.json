      "env": {
        "ANTHROPIC_API_KEY": "sk-ant-api03-1234567890abcdef1234567890abcdef1234567890abcdef",
        "GOOGLE_API_KEY": "AIzaSyBH7XN8H9F2K3L4M5N6O7P8Q9R0S1T2U3V",
        "OPENAI_API_KEY": "sk-proj-1234567890abcdef1234567890abcdef1234567890abcdef",
        "DEEPSEEK_API_KEY": "sk-8320bfa05aee44bfb5cfa222b4965807",
        "KIMI_API_KEY": "sk-6AB1LgWd6pdbWiWYOV4DNliaTLUmVpKPwuGO2byYChYNvBG0",
        "SILICONFLOW_API_KEY": "sk-ixqakhbhdcawjxayfncaksoyqscrjkzufonflbbwawqmlsej",
        "CUSTOM_API_URL": "https://api.siliconflow.cn/v1",
        "CUSTOM_API_KEY": "sk-ixqakhbhdcawjxayfncaksoyqscrjkzufonflbbwawqmlsej",
