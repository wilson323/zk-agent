    },
    "filesystem": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "/mnt/d/zker-agents"],
      "disabled": false,
      "autoApprove": [
        "read_file", "write_file", "list_directory", "create_directory",
        "search_files", "get_file_info", "read_multiple_files", "edit_file",
        "move_file", "list_allowed_directories", "directory_tree",
