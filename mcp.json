        "/mnt/f/jj/mcp-sequential-thinking/mcp_sequential_thinking",
        "run",
        "server.py"
      ]
    },
    "shrimp": {
      "command": "node",
      "args": ["/mnt/d/zker-agents/mcp/mcp-shrimp-task-manager/dist/index.js"],
      "disabled": false,
      "autoApprove": [
        "plan_task", "analyze_task", "reflect_task", "split_tasks",
