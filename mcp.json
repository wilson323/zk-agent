    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "disabled": false,
      "autoApprove": ["get_current_time", "convert_time"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "/mnt/d/zker-agents"],
      "disabled": false,
      "autoApprove": [
        "git_status", "git_diff_unstaged", "git_diff_staged", "git_diff",
        "git_commit", "git_add", "git_reset", "git_log", "git_create_branch",
        "git_checkout", "git_show", "git_init", "git_branch"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "disabled": false,
      "autoApprove": ["fetch"]
    },
    "codelogic": {
      "command": "uvx",
      "args": ["codelogic-mcp-server"],
      "disabled": false,
      "autoApprove": ["codelogic_method_impact", "codelogic_database_impact"]
    }
