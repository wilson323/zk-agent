{
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts",
                    "app/**/*",
                    "components/**/*",
                    "lib/**/*",
                    "contexts/**/*",
                    "hooks/**/*",
                    "types/**/*",
                    "utils/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "backend",
                    "frontend/src",
                    "src",
                    "dist",
                    "build",
                    ".next",
                    "out"
                ],
    "compilerOptions":  {
                            "noEmit":  true,
                            "baseUrl":  ".",
                            "strict":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "module":  "esnext",
                            "incremental":  true,
                            "moduleResolution":  "bundler",
                            "isolatedModules":  true,
                            "skipLibCheck":  true,
                            "allowJs":  true,
                            "target":  "ES2020",
                            "resolveJsonModule":  true,
                            "esModuleInterop":  true,
                            "paths":  {
                                          "@/contexts/*":  [
                                                               "./contexts/*"
                                                           ],
                                          "@/components/*":  [
                                                                 "./components/*"
                                                             ],
                                          "@/docs/*":  [
                                                           "./docs/*"
                                                       ],
                                          "@/services/*":  [
                                                               "./services/*"
                                                           ],
                                          "@/backend/*":  [
                                                              "./backend/*"
                                                          ],
                                          "@/lib/*":  [
                                                          "./lib/*"
                                                      ],
                                          "@/*":  [
                                                      "./app/*",
                                                      "./components/*",
                                                      "./lib/*"
                                                  ],
                                          "@/types/*":  [
                                                            "./types/*"
                                                        ],
                                          "@/app/*":  [
                                                          "./app/*"
                                                      ],
                                          "@/hooks/*":  [
                                                            "./hooks/*"
                                                        ],
                                          "@/utils/*":  [
                                                            "./utils/*"
                                                        ]
                                      },
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "ES6"
                                    ],
                            "jsx":  "preserve"
                        }
}
