{
  "rules": {
    "maxFileSize": "500kb",
    "maxFunctionLength": 50,
    "maxComplexity": 10,
    "unusedImportsThreshold": 5,
    "deadCodeThreshold": 3
  },
  "excludePatterns": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "autoFix": {
    "removeUnusedImports": true,
    "removeEmptyDirectories": true,
    "removeTempFiles": true
  }
}